{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/quranpedia/quran-word-index/schema/mushaf-1.0.json",
  "title": "quran-mushaf 1.0",
  "description": "One muṣḥaf, published on its own, with every word carrying the global word ID. Normative form; see docs/MUSHAF-FORMAT.md.",
  "type": "object",
  "required": [
    "format",
    "format_version",
    "generated",
    "mushaf",
    "provenance",
    "spine",
    "suras",
    "ayat",
    "words",
    "resegmentation"
  ],
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "quran-mushaf"
    },
    "format_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$"
    },
    "generated": {
      "type": "string",
      "format": "date"
    },
    "variant": {
      "const": "minimal"
    },
    "mushaf": {
      "type": "object",
      "required": [
        "key",
        "name_en",
        "name_ar",
        "ayah_count",
        "word_count"
      ],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z]+$"
        },
        "name_en": {
          "type": "string"
        },
        "name_ar": {
          "type": "string"
        },
        "qari_en": {
          "type": "string"
        },
        "qari_ar": {
          "type": "string"
        },
        "counting": {
          "type": "string"
        },
        "ayah_count": {
          "type": "integer",
          "minimum": 1
        },
        "word_count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "provenance": {
      "description": "Which KFGQPC release every part of this file came from.",
      "type": "object",
      "required": [
        "text",
        "policy"
      ],
      "properties": {
        "text": {
          "$ref": "#/$defs/package"
        },
        "layout": {
          "$ref": "#/$defs/package"
        },
        "policy": {
          "type": "string"
        }
      }
    },
    "spine": {
      "type": "object",
      "required": [
        "word_id_range"
      ],
      "properties": {
        "word_id_range": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "note": {
          "type": "string"
        }
      }
    },
    "layers": {
      "description": "What this file carries, and why it lacks whatever it lacks.",
      "type": "object",
      "required": [
        "present",
        "absent"
      ],
      "properties": {
        "present": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "absent": {
          "description": "layer name -> why it is not here",
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "derived": {
          "description": "Layers inferred rather than read, each with its score.",
          "type": "object",
          "additionalProperties": {
            "type": "object"
          }
        },
        "notes": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "mark_signs": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "cp",
          "unicode_name"
        ],
        "properties": {
          "cp": {
            "type": "string",
            "pattern": "^U\\+[0-9A-F]{4}$"
          },
          "unicode_name": {
            "type": "string"
          }
        }
      }
    },
    "suras": {
      "type": "array",
      "minItems": 114,
      "maxItems": 114,
      "items": {
        "type": "object",
        "required": [
          "n",
          "name_ar",
          "name_en",
          "basmalah",
          "ayat",
          "words"
        ],
        "properties": {
          "n": {
            "type": "integer",
            "minimum": 1,
            "maximum": 114
          },
          "name_ar": {
            "type": "string"
          },
          "name_en": {
            "type": "string"
          },
          "revelation": {
            "enum": [
              "makki",
              "madani"
            ]
          },
          "basmalah": {
            "type": "boolean"
          },
          "ayat": {
            "type": "integer",
            "minimum": 1
          },
          "words": {
            "$ref": "#/$defs/span"
          },
          "pages": {
            "$ref": "#/$defs/span"
          }
        }
      }
    },
    "ayat": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "sura",
          "n",
          "words"
        ],
        "properties": {
          "sura": {
            "type": "integer",
            "minimum": 1,
            "maximum": 114
          },
          "n": {
            "description": "0 means printed but not numbered — the basmalah of Al-Fātiḥah in the muṣḥafs that do not count it.",
            "type": "integer",
            "minimum": 0
          },
          "words": {
            "$ref": "#/$defs/span"
          }
        }
      }
    },
    "pages": {
      "$ref": "#/$defs/numbered_spans"
    },
    "juz": {
      "$ref": "#/$defs/numbered_spans"
    },
    "resegmentation": {
      "description": "Every place this build changed the source's own word spacing. Present even when empty, so silence is never ambiguous.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "words",
          "sura",
          "ayah",
          "kind",
          "source_text",
          "emitted"
        ],
        "properties": {
          "words": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "sura": {
            "type": "integer"
          },
          "ayah": {
            "type": "integer"
          },
          "kind": {
            "enum": [
              "joined_in_source",
              "split_in_source",
              "unresolved_boundary"
            ]
          },
          "source_text": {
            "type": "string"
          },
          "emitted": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "riwayat_agree": {
            "description": "true means every muṣḥaf reads the run identically once re-segmented — a source that lost a space, not a muṣḥaf that prints the words joined.",
            "type": "boolean"
          }
        }
      }
    },
    "line_disagreements": {
      "description": "Every āyah where the reconstructed line differs from the release that states it. Lines are inferred, not read; see docs/MUSHAF-FORMAT.md.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "sura",
          "ayah",
          "derived",
          "source"
        ],
        "properties": {
          "sura": {
            "type": "integer"
          },
          "ayah": {
            "type": "integer"
          },
          "derived": {
            "type": "integer"
          },
          "source": {
            "type": "integer"
          }
        }
      }
    },
    "words": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "w",
          "t"
        ],
        "additionalProperties": false,
        "properties": {
          "w": {
            "description": "Global word ID. The same w is the same word in every muṣḥaf that has it; a muṣḥaf lacking a word leaves a gap.",
            "type": "integer",
            "minimum": 1
          },
          "t": {
            "description": "ʿUthmānī text as this muṣḥaf prints it.",
            "type": "string"
          },
          "pg": {
            "description": "Printed page — read from the release.",
            "type": "integer",
            "minimum": 1
          },
          "ln": {
            "description": "Printed line — reconstructed, not read.",
            "type": "integer",
            "minimum": 1
          },
          "e": {
            "description": "Imlāʾī, only where a release supplies it. Never generated.",
            "type": "string"
          },
          "resegmented": {
            "const": true
          },
          "marks": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "k",
                "at",
                "sign"
              ],
              "properties": {
                "k": {
                  "enum": [
                    "waqf",
                    "hizb",
                    "sajdah"
                  ]
                },
                "at": {
                  "enum": [
                    "before",
                    "after"
                  ]
                },
                "sign": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "span": {
      "description": "[first, last], inclusive.",
      "type": "array",
      "items": {
        "type": "integer"
      },
      "minItems": 2,
      "maxItems": 2
    },
    "numbered_spans": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "n",
          "words"
        ],
        "properties": {
          "n": {
            "type": "integer",
            "minimum": 1
          },
          "words": {
            "$ref": "#/$defs/span"
          }
        }
      }
    },
    "package": {
      "type": "object",
      "required": [
        "package",
        "member",
        "sha256"
      ],
      "properties": {
        "package": {
          "type": "string"
        },
        "member": {
          "type": "string"
        },
        "release_year": {
          "type": "integer"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "used_for": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "$comment": "The minimal variant drops the conveniences and keeps the disclosures. Everything else must declare its layers.",
      "if": {
        "not": {
          "required": [
            "variant"
          ]
        }
      },
      "then": {
        "required": [
          "layers"
        ]
      }
    }
  ]
}
