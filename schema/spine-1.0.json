{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/quranpedia/quran-word-index/schema/spine-1.0.json",
  "title": "quran-spine 1.0",
  "description": "The shared numbering: every number with a text, its Ḥafṣ coordinates, and each muṣḥaf's form of it. Normative alongside the muṣḥaf files; see docs/MUSHAF-FORMAT.md.",
  "type": "object",
  "required": ["format", "format_version", "generated", "total", "mushafs", "words"],
  "additionalProperties": false,
  "properties": {
    "format": { "const": "quran-spine" },
    "format_version": { "type": "string", "pattern": "^\\d+\\.\\d+$" },
    "generated": { "type": "string", "format": "date" },
    "total": { "type": "integer", "minimum": 1 },
    "mushafs": { "type": "array", "items": { "type": "string" } },
    "note": { "type": "string" },
    "words": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["number", "sura", "rasm", "pointed", "uthmani", "simple", "status", "hafs", "forms", "ayah"],
        "additionalProperties": false,
        "properties": {
          "number": { "type": "integer", "minimum": 1, "description": "The shared number; words[i].number == i + 1." },
          "sura": { "type": "integer", "minimum": 1, "maximum": 114 },
          "rasm": { "type": "string" },
          "pointed": { "type": "string" },
          "uthmani": { "type": "string", "description": "Canonical spelling of this one word, from a muṣḥaf that writes it apart." },
          "simple": { "type": "string" },
          "status": { "enum": ["identical", "diacritic_variant", "dotting_variant", "alif_variant", "rasm_variant", "word_boundary", "partial"] },
          "hafs": {
            "description": "The word's sūrah, āyah and position in the āyah in the Kūfī count, or null where Ḥafṣ does not read the word. Two numbers Ḥafṣ writes as one word share the same coordinates.",
            "oneOf": [
              { "type": "null" },
              { "type": "object", "required": ["sura", "ayah", "pos"], "additionalProperties": false,
                "properties": { "sura": { "type": "integer", "minimum": 1 }, "ayah": { "type": "integer", "minimum": 1 },
                                "pos": { "type": "integer", "minimum": 1 } } }
            ]
          },
          "forms": {
            "type": "object",
            "description": "Each muṣḥaf's own spelling; absent iff the muṣḥaf does not read the word. Where a muṣḥaf writes the number joined with its neighbour this is the joined word, repeated on both numbers.",
            "additionalProperties": { "type": "string" }
          },
          "ayah": {
            "type": "object",
            "description": "Āyah number in each muṣḥaf's own count; 0 is the unnumbered basmalah of Al-Fātiḥah.",
            "additionalProperties": { "type": "integer", "minimum": 0 }
          },
          "written_joined": {
            "type": "array",
            "description": "The muṣḥafs whose printed word here covers more than this number.",
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}
